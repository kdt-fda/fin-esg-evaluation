# 1. 베이스 이미지 선택
FROM python:3.12-slim

# 2. 한국 시간 설정
RUN apt-get update && apt-get install -y tzdata build-essential gcc g++ git && \
    ln -sf /usr/share/zoneinfo/Asia/Seoul /etc/localtime && \
    echo "Asia/Seoul" > /etc/timezone && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

# 3. 컨테이너 내부 작업 폴더 설정
WORKDIR /app

# 4. 라이브러리 설치
COPY requirements.txt .
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir numpy==1.26.4 pandas==2.3.3 && \
    pip install --no-cache-dir pandas-ta==0.4.71b0 --no-deps && \
    pip install --no-cache-dir -r requirements.txt

# 5. 내 코드 전부 복사
COPY . .

# 6. 로그 저장 폴더 생성
RUN mkdir -p /app/logs

# 7. 환경 변수 설정 (Python 출력 로그 확인용)
ENV PYTHONUNBUFFERED=1

# 8. 실행
CMD ["python", "main_interpreter.py"]